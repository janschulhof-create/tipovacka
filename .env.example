# Ukázkové proměnné prostředí.
# Zkopíruj jako `.env.local` a doplň skutečné hodnoty.
# `.env` a `.env.local` jsou v .gitignore a NIKDY se neverzují.

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://vas-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Synchronizace ───────────────────────────────────────────────────────
CRON_SECRET=
HIGHLIGHTLY_API_KEY=
FOOTBALL_DATA_TOKEN=

# ── AI Baroko + Dohráno + notifikace ────────────────────────────────────
# Pro Vercel; stejné ANTHROPIC_* nastav také v Supabase Edge Functions Secrets.
ANTHROPIC_API_KEY=
ANTHROPIC_ROAST_MODEL=claude-sonnet-4-6
# Timeout volání Claude v ms (povolený rozsah 5000–60000, výchozí 30000)
ANTHROPIC_TIMEOUT_MS=30000
# Tajemství pro chráněný diagnostický endpoint POST /api/ai-health
AI_HEALTH_SECRET=

# ── Webové notifikace (vygeneruj: npm run push:keys) ────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Založení hráče (npm run seed:player) ────────────────────────────────
# Nastav jen dočasně při spuštění skriptu, do souboru nezapisuj.
SEED_PLAYER_NAME=
SEED_PLAYER_EMAIL=
SEED_PLAYER_PASSWORD=

# ── Přechodné příznaky ──────────────────────────────────────────────────
# 0 = vypne klientem spouštěnou synchronizaci (až po ověření serverového cronu)
NEXT_PUBLIC_CLIENT_SYNC=1
